{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QUBO component export v1",
  "type": "object",
  "required": ["schema_version", "convention", "coefficient_type", "offset", "bits", "linear", "quadratic", "codebooks", "auxiliaries", "applicability", "provenance", "sha256"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "qubo-component/1"},
    "convention": {"const": "offset+linear+strict-upper-quadratic"},
    "coefficient_type": {"enum": ["BigInt", "Rational{BigInt}", "Float64"]},
    "offset": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "applicability": {"type": "string"},
    "provenance": {"type": "string"},
    "bits": {"type": "array", "items": {"$ref": "#/$defs/bit"}},
    "linear": {"type": "array", "items": {"type": "object", "required": ["i", "coefficient"], "properties": {"i": {"type": "integer", "minimum": 1}, "coefficient": {"type": "string"}}, "additionalProperties": false}},
    "quadratic": {"type": "array", "items": {"type": "object", "required": ["i", "j", "coefficient"], "properties": {"i": {"type": "integer", "minimum": 1}, "j": {"type": "integer", "minimum": 1}, "coefficient": {"type": "string"}}, "additionalProperties": false}},
    "codebooks": {"type": "array", "items": {"type": "object", "required": ["variable", "bits", "values", "codes", "value_indices"], "properties": {"variable": {"type": "string"}, "bits": {"type": "array", "items": {"$ref": "#/$defs/bit"}}, "values": {"type": "array", "items": {"$ref": "#/$defs/value"}}, "codes": {"type": "array", "items": {"type": "array", "items": {"enum": [0,1]}}}, "value_indices": {"type": "array", "items": {"type": "integer", "minimum": 1}}}, "additionalProperties": false}},
    "auxiliaries": {"type": "array", "items": {"type": "object", "required": ["bit", "meaning"], "properties": {"bit": {"$ref": "#/$defs/bit"}, "meaning": {"type": "string"}}, "additionalProperties": false}},
    "certificate": {"type": "object", "required": ["status", "profile", "proof", "oracle_id", "gap", "atol", "evaluations", "valid_codes", "invalid_codes", "representation_policy", "reason"], "properties": {
      "status": {"enum": ["pass", "fail", "failed", "unknown", "surrogate"]},
      "profile": {"enum": ["indicator_exact", "zero_set_exact", "surrogate"]},
      "proof": {"enum": ["proved", "exhaustive", "validated", "unknown"]},
      "oracle_id": {"type": "string", "minLength": 1},
      "gap": {"type": "string"}, "atol": {"type": "string"},
      "evaluations": {"type": "integer", "minimum": 0},
      "valid_codes": {"type": "integer", "minimum": 0},
      "invalid_codes": {"type": "integer", "minimum": 0},
      "representation_policy": {"const": "every_valid_code"},
      "reason": {"type": "string"}, "min_violation": {"type": "string"},
      "counterexample": {"type": "object", "required": ["primary_mask", "bits", "values", "valid_code", "satisfied", "energy"], "properties": {"primary_mask": {"type": "integer", "minimum": 0}, "bits": {"type": "array", "items": {"enum": [0,1]}}, "values": {"type": "array", "items": {"$ref": "#/$defs/value"}}, "valid_code": {"type": "boolean"}, "satisfied": {"type": "boolean"}, "energy": {"type": "string"}}, "additionalProperties": false}
    }, "additionalProperties": false}
  },
  "$defs": {
    "bit": {"type": "object", "required": ["owner", "index", "role"], "properties": {"owner": {"type": "string"}, "index": {"type": "integer", "minimum": 1}, "role": {"enum": ["primary", "semantic_auxiliary", "quadratization_auxiliary"]}}, "additionalProperties": false},
    "value": {"type": "object", "required": ["type", "value"], "properties": {"type": {"type": "string"}, "value": {"type": "string"}}, "additionalProperties": false}
  }
}
